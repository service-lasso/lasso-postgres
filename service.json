{
  "id": "postgres",
  "name": "PostgreSQL",
  "description": "Release-backed PostgreSQL service for local Service Lasso data dependencies.",
  "version": "15.17",
  "enabled": true,
  "endpoints": [
    {
      "id": "service",
      "kind": "network",
      "label": "PostgreSQL TCP",
      "direction": "inbound",
      "transport": "tcp",
      "protocol": "tcp",
      "bind": "127.0.0.1",
      "port": {
        "default": 8500,
        "strategy": "preferred"
      },
      "exposure": "local",
      "primary": true
    },
    {
      "id": "postgres",
      "kind": "url",
      "label": "PostgreSQL",
      "target": "service",
      "url": "postgresql://${endpoint.service.bind}:${endpoint.service.port}/postgres",
      "exposure": "local",
      "primary": true
    }
  ],
  "env": {
    "POSTGRES_HOST": "${endpoint.service.bind}",
    "POSTGRES_PORT": "${endpoint.service.port}",
    "POSTGRES_URL": "${endpoint.postgres.url}",
    "POSTGRES_USER": "pgadmin",
    "POSTGRES_PASSWORD": "pgadmin",
    "POSTGRES_DATABASES": "keycloak",
    "POSTGRES_DATA_DIR": "${SERVICE_ROOT}/runtime/data",
    "PGPASSWORD": "${POSTGRES_PASSWORD}"
  },
  "globalenv": {
    "POSTGRES_HOST": "${POSTGRES_HOST}",
    "POSTGRES_PORT": "${POSTGRES_PORT}",
    "POSTGRES_URL": "${POSTGRES_URL}",
    "POSTGRES_USER": "${POSTGRES_USER}",
    "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}",
    "POSTGRES_HOME": "${SERVICE_ARTIFACT_ROOT}",
    "POSTGRE_HOST": "${POSTGRES_HOST}",
    "POSTGRE_PORT": "${POSTGRES_PORT}",
    "POSTGRE_URL": "${POSTGRES_URL}",
    "POSTGRE_AUTH_USERNAME": "${POSTGRES_USER}",
    "POSTGRE_AUTH_PASSWORD": "${POSTGRES_PASSWORD}",
    "POSTGRE_HOME": "${SERVICE_ARTIFACT_ROOT}"
  },
  "artifact": {
    "kind": "archive",
    "source": {
      "type": "github-release",
      "repo": "service-lasso/lasso-postgres",
      "channel": "latest"
    },
    "platforms": {
      "win32": {
        "assetName": "lasso-postgres-15.17-win32.zip",
        "archiveType": "zip",
        "command": "node",
        "args": ["./lasso-postgres.mjs"]
      },
      "darwin": {
        "assetName": "lasso-postgres-15.17-darwin.tar.gz",
        "archiveType": "tar.gz",
        "command": "node",
        "args": ["./lasso-postgres.mjs"]
      },
      "linux": {
        "assetName": "lasso-postgres-15.17-linux.tar.gz",
        "archiveType": "tar.gz",
        "command": "node",
        "args": ["./lasso-postgres.mjs"]
      }
    }
  },
  "install": {
    "files": [
      {
        "path": "./runtime/data/.keep",
        "content": ""
      },
      {
        "path": "./runtime/.keep",
        "content": ""
      }
    ]
  },
  "healthchecks": [
    {
      "id": "tcp-ready",
      "type": "tcp",
      "address": "${endpoint.service.bind}:${endpoint.service.port}",
      "retries": 80,
      "interval": 250
    }
  ],
  "updates": {
    "enabled": true,
    "mode": "notify",
    "track": "latest",
    "checkIntervalSeconds": 86400
  }
}
